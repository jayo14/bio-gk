# ==========================================
# Bio Gatekeeper - Environment Configuration
# ==========================================

# Django Backend Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-64-character-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Application URLs
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Paystack Payment Gateway (Secret key is strictly backend-only)
PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_paystack_public_key
PLATFORM_FEE_PERCENT=10

# Email Delivery Configuration (Used for password recovery and creator alerts)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=support@yourdomain.com
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=replace-with-smtp-api-key
EMAIL_USE_TLS=True

# WhatsApp Cloud API Notifications (Optional - fallback to email if unconfigured)
WHATSAPP_CLOUD_API_TOKEN=replace-with-facebook-graph-api-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
